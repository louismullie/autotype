{
  "name": "autotype",
  "displayName": "Autotype",
  "description": "Inline inferred Ruby method signatures powered by the autotype gem",
  "version": "0.1.0",
  "publisher": "doximity",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/doximity/autotype" },
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ruby"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "properties": {
        "autotype.command": {
          "type": "string",
          "default": "autotype",
          "description": "Command used to run type inference (e.g. bundle exec autotype)"
        },
        "autotype.fileGlobs": {
          "type": "array",
          "default": ["app/**/*.rb", "lib/**/*.rb", "config/**/*.rb"],
          "description": "Git ls-files globs passed to autotype"
        },
        "autotype.cacheFile": {
          "type": "string",
          "default": "tmp/autotype_cache.json",
          "description": "Workspace-relative cache file for inferred signatures"
        }
      }
    },
    "commands": [
      { "command": "autotype.refresh", "title": "Autotype: Refresh" },
      { "command": "autotype.toggle", "title": "Autotype: Toggle Inline Signatures" }
    ]
  }
}
